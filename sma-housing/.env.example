PORT=3000

# Leave DATABASE_URL empty to use the built-in SQLite file (db/housing.sqlite) - zero-config local runs.
# Set it for PostgreSQL / Azure Database for PostgreSQL / Supabase in production:
# DATABASE_URL=postgres://username:password@localhost:5432/sma_housing
DATABASE_URL=

# local = username/password login against the users table (demo users seeded automatically)
# entra = verify Microsoft Entra ID bearer tokens (fill the ENTRA_* values below)
AUTH_MODE=local
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_HOURS=12

# Microsoft Entra ID (used when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=
