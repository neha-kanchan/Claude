{
  "name": "sma-housing-system",
  "version": "2.0.0",
  "description": "SMA Student Housing Management System - full-stack: Express REST API, PostgreSQL/SQLite database, Microsoft Entra ID SSO or local JWT auth, role-based permissions, audit trail, prod/non-prod environments.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "install:web": "npm --prefix web install",
    "test": "node test/run.mjs",
    "test:all": "node test/run.mjs --browser"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
