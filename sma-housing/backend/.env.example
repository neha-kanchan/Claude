# SQLite (default) - a file, nothing to install.
DATABASE_URL="file:./dev.db"

# PostgreSQL - set the provider in prisma/schema.prisma to "postgresql", then:
# DATABASE_URL="postgresql://user:password@localhost:5432/sma_housing"

PORT=3000

# local = username/password against the users table; entra = verify Microsoft Entra ID tokens
AUTH_MODE=local
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_HOURS=12

# Microsoft Entra ID (used when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_AUDIENCE=
