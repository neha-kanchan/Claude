{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "npm run setup",
      "problemMatcher": []
    },
    {
      "label": "NestJS API (port 3000)",
      "type": "shell",
      "command": "npm run dev:api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend dev server (port 5173)",
      "type": "shell",
      "command": "npm run dev:web",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start developing",
      "dependsOn": [
        "NestJS API (port 3000)",
        "Frontend dev server (port 5173)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build for production",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": []
    },
    {
      "label": "Prisma Studio (browse the database)",
      "type": "shell",
      "command": "npm run prisma:studio --prefix backend",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
